# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files - ALL of them, no exceptions.
# Required variables are documented in README.md, not in a committable file.
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# IDE / agent local settings - may contain access tokens
.qoder/
.vscode/
.idea/

# Locally-installed agent skills (e.g. `npx skills add ...`) - per-machine
# tooling for AI assistants, not part of the app.
.agents/
skills-lock.json

# Local verification screenshot output
tmp/
